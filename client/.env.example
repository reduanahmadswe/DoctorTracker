# Base URL of the Express API (used by the /api rewrite in next.config.ts).
# The browser only ever talks to the client origin; Next.js forwards /api/* to this URL.
API_URL=http://localhost:5000

# Optional: show a demo login box (with a one-click fill button) on the sign-in page.
# Both values must be set for it to appear, so leave them out in production.
# They must match SEED_ADMIN_EMAIL and SEED_ADMIN_PASSWORD in server/.env.
NEXT_PUBLIC_DEMO_EMAIL=admin@example.com
NEXT_PUBLIC_DEMO_PASSWORD=change-me-please
