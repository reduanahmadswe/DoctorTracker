# Runtime mode: development | production | test
NODE_ENV=development

# Port the Express API listens on
PORT=5000

# MongoDB connection string (local instance or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/doctor-tracker

# Secret used to sign login tokens. Use a random string of at least 32 characters, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters

# How long a login stays valid (examples: 12h, 1d, 7d). Also sets the cookie lifetime.
JWT_EXPIRES_IN=1d

# Origin of the client app; the only origin allowed by CORS
CLIENT_ORIGIN=http://localhost:3000

# Credentials of the admin account created by `npm run seed:admin`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please
